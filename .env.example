# 개발 기본값 — 복사해서 .env 로 쓴다 (운영 값은 커밋하지 않는다)
DATABASE_URL=postgres://neodb:neodb-dev@localhost:55432/neodb
API_PORT=4310
SESSION_IDLE_MIN=30
SESSION_ABSOLUTE_HOURS=12
# 최초 관리자 (db:seed 가 한 번만 만든다 — 첫 로그인에서 비밀번호를 바꿔야 한다)
SEED_ADMIN_ID=admin
SEED_ADMIN_NAME=시스템 관리자
# 시험 계정(db:seed:test) 공통 비밀번호 — 개발 · 시험 전용 시험값, 운영에는 넣지 않는다
TEST_PASSWORD=Neodb-test-2026!
